### 图像合成 API - POST 请求
POST https://stagnant-illusion.rbq.dev/api
Content-Type: application/json

{
  "baseImage": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==",
  "overlayImage": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==",
  "coverImage": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==",
  "options": {
    "pos-x": 0,
    "pos-y": 0,
    "scale": 1,
    "opacity": 0.8,
    "brightness": 100,
    "useCover": true,
    "coverOpacity": 1
  }
}

