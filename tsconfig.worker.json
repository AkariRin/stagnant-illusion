{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["worker/**/*.ts", "functions/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "lib": ["ESNext"],
    "skipLibCheck": true
  }
}
